{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["google-apps-script"],
    "lib": ["ES2020", "DOM"],
    "outDir": "dist-types"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/ui/**/*"]
}
